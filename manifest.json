{
  "manifest_version": 3,
  "name": "CEO SWAP — AI Passport ⇄ ChatGPT",
  "version": "0.3.0",
  "description": "Pair TH-AI Passport and ChatGPT by Project ID, Pair ID and browser tabs, then exchange prompts in both directions without auto-send.",
  "permissions": ["storage", "tabs", "activeTab"],
  "host_permissions": [
    "https://aipass.go.th/*",
    "https://www.aipass.go.th/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "CEO SWAP",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://aipass.go.th/*", "https://www.aipass.go.th/*"],
      "js": ["content-aipass.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content-chatgpt.js"],
      "run_at": "document_idle"
    }
  ]
}
